    "argon2": "^0.44.0",
    "dotenv": "^17.2.1",
    "fastify": "^5.5.0",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "eslint": "^9.33.0",
    "globals": "^16.3.0",
    "prisma": "^6.14.0",
    "vitest": "^3.2.4"
  }
